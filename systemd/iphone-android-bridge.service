[Unit]
Description=Secure LocalLedger iPhone SMS bridge
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/share/iphone-sms-backup/venv/bin/python %h/.local/share/iphone-sms-backup/iphone_backup_app.py android-bridge
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
